# Variables for docker-compose.vps.yml (the web app on the VPS).
# With Dokploy, paste these into the service's Environment tab.

# REQUIRED: public domain served by Dokploy for svelte-mpd (ORIGIN is https://$DOMAIN)
DOMAIN=music.example.com

# REQUIRED: password for the web UI login screen
ADMIN_PASSWORD=

# REQUIRED: mpd-bridge on the Raspberry Pi, published by the Cloudflare tunnel
MPD_BRIDGE_URL=https://mpd-bridge.example.com
# Same value as BRIDGE_API_TOKEN in the Pi's .env
MPD_BRIDGE_TOKEN=

# Cloudflare Access service token protecting the bridge hostname
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Optional: key that signs article audio URLs fetched by MPD. When empty it is
# derived from ADMIN_PASSWORD (changing the password then breaks article audio
# saved in playlists). Generate with: openssl rand -hex 32
AUDIO_URL_SECRET=

# Optional: AI assistant
ANTHROPIC_API_KEY=
ASSISTANT_TOKEN=
# Optional: OpenAI cloud speech-to-text instead of the local Whisper sidecar
OPENAI_API_KEY=
