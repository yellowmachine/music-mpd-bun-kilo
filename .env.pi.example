# Variables for docker-compose.pi.yml (MPD, Snapcast, mpd-bridge and
# cloudflared on the Raspberry Pi). Copy to .env next to the compose file.

# REQUIRED: token the bridge accepts (openssl rand -hex 32).
# Use the same value as MPD_BRIDGE_TOKEN on the VPS.
BRIDGE_API_TOKEN=

# REQUIRED: token of the Cloudflare tunnel (Zero Trust > Networks > Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=
