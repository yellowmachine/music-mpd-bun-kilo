# Variables for docker-compose.pi.yml (MPD, Snapcast, mpd-bridge and
# cloudflared on the Raspberry Pi). Copy to .env next to the compose file.

# REQUIRED: token the bridge accepts (openssl rand -hex 32).
# Use the same value as MPD_BRIDGE_TOKEN on the VPS.
BRIDGE_API_TOKEN=

# REQUIRED: token of the Cloudflare tunnel (Zero Trust > Networks > Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=

# REQUIRED: token for POST /admin/update, which CI calls after publishing a new
# mpd-bridge image (openssl rand -hex 32). Must differ from BRIDGE_API_TOKEN.
# Use the same value as the MPD_BRIDGE_UPDATE_TOKEN GitHub secret.
BRIDGE_UPDATE_TOKEN=

# REQUIRED: token between the bridge and Watchtower, on the internal network
# only (openssl rand -hex 32).
WATCHTOWER_TOKEN=
